<?xml version="1.0" encoding="UTF-8"?>

<schemalist>

    <schema path="/org/gnome/shell/extensions/dash-tasks-panel/" id="org.gnome.shell.extensions.dash-tasks-panel">

        <key type="b" name="light-style">
            <default>true</default>
            <summary>Light style mode</summary>
        </key>

        <key type="b" name="yaru-panel">
            <default>true</default>
            <summary>Normal-weighted fonts</summary>
        </key>

        <key type="b" name="accent-panel">
            <default>false</default>
            <summary>Use accent color</summary>
        </key>

        <key type="b" name="use-background-color">
            <default>false</default>
            <summary>Custom background color</summary>
        </key>

        <key name="background-color" type="s">
            <default>"rgba(0,0,0,1)"</default>
            <summary>Custom background color</summary>
        </key>

        <key type="b" name="move-date">
            <default>true</default>
            <summary>Move the clock to the right</summary>
        </key>

        <key type="b" name="scroll-panel">
            <default>true</default>
            <summary>Scroll on panel to change workspace</summary>
        </key>

        <key type="b" name="show-user-id">
            <default>true</default>
            <summary>Show user name</summary>
        </key>

        <key type="b" name="show-show-desktop">
            <default>true</default>
            <summary>Show show desktop button</summary>
        </key>

        <key type="b" name="show-workspaces-bar">
            <default>true</default>
            <summary>Show workspaces bar</summary>
        </key>

        <key type="b" name="show-plus-minus">
            <default>true</default>
            <summary>Show +/- to add/remove workspace</summary>
        </key>

        <key type="b" name="show-favorites-menu">
            <default>true</default>
            <summary>Show favorites menu button</summary>
        </key>

        <key type="b" name="show-recent-apps-menu">
            <default>true</default>
            <summary>Show recent applications menu button</summary>
        </key>

        <key type="b" name="show-dash">
            <default>true</default>
            <summary>Show dash before the tasks</summary>
        </key>

        <key type="s" name="dash-align">
            <choices>
                <choice value="left"/>
                <choice value="center"/>
                <choice value="right"/>
            </choices>
            <default>"left"</default>
            <summary>Dash alignment</summary>
        </key>

        <key type="b" name="show-app-grid-button">
            <default>false</default>
            <summary>Show app grid button in the dash</summary>
        </key>

        <key type="b" name="dash-labels-above">
            <default>false</default>
            <summary>Show dash hover labels above the icons</summary>
        </key>

        <key type="i" name="dash-icon-size">
            <range min="12" max="48"/>
            <default>20</default>
            <summary>Dash icon size</summary>
        </key>

        <key type="i" name="dash-icon-margin">
            <range min="0" max="20"/>
            <default>2</default>
            <summary>Dash app button horizontal margin</summary>
        </key>

        <key type="b" name="show-dash-separator">
            <default>true</default>
            <summary>Show dash separator</summary>
        </key>

        <key type="i" name="dash-separator-margin">
            <range min="0" max="16"/>
            <default>8</default>
            <summary>Dash separator horizontal margin</summary>
        </key>

        <key type="b" name="dash-indicator-accent">
            <default>true</default>
            <summary>Dash running indicator uses the accent color</summary>
        </key>

        <key type="b" name="dash-indicator-use-color">
            <default>false</default>
            <summary>Use custom dash running indicator color</summary>
        </key>

        <key type="s" name="dash-indicator-color">
            <default>"rgba(255,255,255,1)"</default>
            <summary>Custom dash running indicator color</summary>
        </key>

        <key type="i" name="dash-indicator-width">
            <range min="1" max="48"/>
            <default>20</default>
            <summary>Dash running indicator width</summary>
        </key>

        <key type="i" name="dash-indicator-thickness">
            <range min="1" max="12"/>
            <default>6</default>
            <summary>Dash running indicator thickness</summary>
        </key>

        <key type="i" name="dash-indicator-offset-y">
            <range min="-12" max="16"/>
            <default>0</default>
            <summary>Dash running indicator vertical offset</summary>
        </key>

        <key type="i" name="recent-apps-list-length">
            <range min="1" max="20"/>
            <default>8</default>
            <summary>Recent applications list maximum length</summary>
        </key>

        <key type="b" name="show-tasks">
            <default>true</default>
            <summary>Show tasks</summary>
        </key>

        <key type="s" name="tasks-align">
            <choices>
                <choice value="left"/>
                <choice value="center"/>
                <choice value="right"/>
            </choices>
            <default>"left"</default>
            <summary>Tasks alignment</summary>
        </key>

        <key type="b" name="show-window-icon">
            <default>true</default>
            <summary>Show window icon inside task button</summary>
        </key>

        <key type="i" name="task-icon-size">
            <range min="12" max="48"/>
            <default>18</default>
            <summary>Window icon size inside task button</summary>
        </key>

        <key type="b" name="show-window-title">
            <default>true</default>
            <summary>Show window title inside task button</summary>
        </key>

        <key type="b" name="show-window-app">
            <default>false</default>
            <summary>Show application name inside task button</summary>
        </key>

        <key type="b" name="show-active-workspace">
            <default>true</default>
            <summary>Show windows on active workspace only</summary>
        </key>

        <key type="b" name="show-focused-window">
            <default>false</default>
            <summary>Show task for focused window only</summary>
        </key>

        <key type="b" name="group-windows">
            <default>false</default>
            <summary>Group windows by app</summary>
        </key>

        <key type="b" name="middle-click-close">
            <default>false</default>
            <summary>Close window on task middle-click</summary>
        </key>

        <key type="b" name="hover-raise-window">
            <default>true</default>
            <summary>Raise window on task hover</summary>
        </key>

        <key type="i" name="hover-delay">
            <range min="0" max="1000"/>
            <default>300</default>
            <summary>Raise window on hover delay</summary>
        </key>

        <key type="b" name="undecorated-task-buttons">
            <default>false</default>
            <summary>Undecorated task buttons</summary>
        </key>

        <key type="b" name="desaturate-icon">
            <default>false</default>
            <summary>Monochrome icon</summary>
        </key>

        <key type="b" name="force-bold-tasks">
            <default>false</default>
            <summary>Force bold font weight in tasks</summary>
        </key>

        <key type="i" name="button-width">
            <range min="-1" max="999"/>
            <default>256</default>
            <summary>Task button natural width</summary>
        </key>

        <key type="b" name="animate-on-close">
            <default>true</default>
            <summary>Animate on close</summary>
        </key>

        <key type="b" name="multi-monitor">
            <default>true</default>
            <summary>Show a task panel on each monitor</summary>
        </key>

    </schema>

</schemalist>
